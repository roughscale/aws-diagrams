# AWS Configuration
# Primary AWS profile for authentication
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Cross-account role configuration
AWS_ORG_ROLE_NAME=OrganizationAccountAccessRole
AWS_SESSION_DURATION=3600

# Topology collection settings
TOPOLOGY_FILE=topology.yaml
CACHE_ENABLED=true
CACHE_TTL=3600
MAX_CONCURRENT_COLLECTORS=5

# Output settings
OUTPUT_DIR=./diagrams
DIAGRAM_FORMAT=awslabs
INCLUDE_METADATA=true

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/aws-topology.log

# Optional: Redis cache configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Optional: Custom AWS endpoints (for testing)
# AWS_ENDPOINT_URL=http://localhost:4566

# Optional: Rate limiting
API_RATE_LIMIT=10
API_BURST_LIMIT=20